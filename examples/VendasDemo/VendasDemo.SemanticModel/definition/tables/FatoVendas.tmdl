table FatoVendas
	lineageTag: 53f03772-e002-492f-86db-4f9f1e251e8a

	/// Receita bruta das vendas no contexto de filtro atual.
	measure 'Receita Total' = SUMX(FatoVendas, FatoVendas[Quantidade] * FatoVendas[PrecoUnitario])
		formatString: R$ #,##0.00
		lineageTag: 0aa51357-ba9d-4e22-80c6-00611c606fad

	/// Custo total das unidades vendidas no contexto de filtro atual.
	measure 'Custo Total' = SUMX(FatoVendas, FatoVendas[Quantidade] * FatoVendas[CustoUnitario])
		formatString: R$ #,##0.00
		lineageTag: d99463a0-3be1-4591-9846-39e6050f59a0

	/// Diferenca entre receita e custo.
	measure Lucro = [Receita Total] - [Custo Total]
		formatString: R$ #,##0.00
		lineageTag: 2cb99929-204e-4a58-8737-8738aae6a18a

	/// Percentual do lucro sobre a receita.
	measure 'Margem %' = DIVIDE([Lucro], [Receita Total])
		formatString: 0.0%
		lineageTag: 383a2134-5fad-4026-8267-34c5c5d71edd

	/// Soma das unidades vendidas.
	measure 'Quantidade Vendida' = SUM(FatoVendas[Quantidade])
		formatString: #,##0
		lineageTag: 670b3862-5a18-45d0-b537-c111e7ad500e

	column VendaId
		dataType: int64
		isHidden
		isKey
		lineageTag: b2e17771-06b1-448e-8f56-686e388f7f95
		summarizeBy: none
		sourceColumn: VendaId

	column Data
		dataType: dateTime
		isHidden
		formatString: dd/MM/yyyy
		lineageTag: e2442e9f-18a5-45bc-93da-9cc81f16990d
		summarizeBy: none
		sourceColumn: Data

	column ProdutoId
		dataType: int64
		isHidden
		lineageTag: fe9a3331-3ecc-4dcd-998e-d87e02836957
		summarizeBy: none
		sourceColumn: ProdutoId

	column Quantidade
		dataType: int64
		formatString: #,##0
		lineageTag: d277e313-6256-4666-a073-5f13ed586e8e
		summarizeBy: sum
		sourceColumn: Quantidade

	column PrecoUnitario
		dataType: decimal
		isHidden
		formatString: R$ #,##0.00
		lineageTag: 6ade790b-7e5f-4c14-ba8f-4b4bcb4fda59
		summarizeBy: none
		sourceColumn: PrecoUnitario

	column CustoUnitario
		dataType: decimal
		isHidden
		formatString: R$ #,##0.00
		lineageTag: 000f4f29-0fed-4ba0-9cfe-c691a29ff126
		summarizeBy: none
		sourceColumn: CustoUnitario

	partition FatoVendas = m
		mode: import
		source =
				let
					Precos = {5200, 1450, 1850, 2400, 480, 620},
					Custos = {3900, 980, 1200, 1650, 290, 370},
					Linhas = List.Transform(
						{1..120},
						each
							let
								VendaId = _,
								ProdutoId = Number.Mod(VendaId - 1, 6) + 1,
								Quantidade = Number.Mod((VendaId - 1) * 3, 5) + 1,
								Data = Date.AddDays(#date(2026, 1, 1), Number.Mod((VendaId - 1) * 17, 90))
							in
								{
									VendaId,
									Data,
									ProdutoId,
									Quantidade,
									Currency.From(Precos{ProdutoId - 1}),
									Currency.From(Custos{ProdutoId - 1})
								}
					),
					Source = #table(
						type table [VendaId = Int64.Type, Data = date, ProdutoId = Int64.Type, Quantidade = Int64.Type, PrecoUnitario = Currency.Type, CustoUnitario = Currency.Type],
						Linhas
					)
				in
					Source
